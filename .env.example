# Local server. Node.js 22 LTS is the CI baseline.
PORT=4747

# Twitch application and the broadcaster and bot logins.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL=
TWITCH_BOT=

# Alibaba Cloud Model Studio, Singapore. Set the endpoint for your key.
DASHSCOPE_API_KEY=
MODELSTUDIO_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Measured defaults. See docs/models.md and docs/check-engine.md.
MODEL_TRIAGE=qwen3.8-flash
MODEL_SEARCH=qwen3.8-flash
MODEL_JUDGE=qwen3.8-max
MODEL_VOD=qwen3.8-flash
MODEL_ASR=qwen-audio-3.1-asr-flash
MODEL_ASR_FALLBACK=qwen3-asr-flash
MODELSTUDIO_ALLOW_PAID_SEARCH=false
SEARCH_MODE=replay
SEARCH_REPLAY_PATH=fixtures/search/probe.json
MODELSTUDIO_TOKEN_LIMIT=900000

# dshow on Windows, avfoundation on macOS, pulse on Linux.
AUDIO_INPUT_FORMAT=dshow
AUDIO_DEVICE=
ASR_LANGUAGE=en
# VOD offset correction measured in probe 1792830555944; see docs/probe.md.
VOD_OFFSET_CORRECTION_S=-3.4

# Set after the M9 public Worker is approved and deployed.
RESULTS_BASE_URL=
RESULTS_SIGNING_KEY=
CHAT_RETENTION_DAYS=14
