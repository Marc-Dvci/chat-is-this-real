# Local server. Node.js 24 LTS is the CI baseline.
PORT=4747

# Twitch application and the broadcaster and bot logins.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL=
TWITCH_BOT=

# Alibaba Cloud Model Studio, Singapore. Set the endpoint for your key.
DASHSCOPE_API_KEY=
MODELSTUDIO_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Measured defaults. See docs/models.md.
MODEL_TRIAGE=qwen3.8-flash
MODEL_SEARCH=qwen3.8-flash
MODEL_JUDGE=qwen3.8-max
MODEL_VOD=qwen3.8-flash
MODEL_ASR=qwen-audio-3.1-asr-flash
MODEL_ASR_FALLBACK=qwen3-asr-flash
# Source discovery: wikipedia (free), provider (Model Studio web search, paid) or replay.
SEARCH_MODE=wikipedia
MODELSTUDIO_ALLOW_PAID_SEARCH=false
SEARCH_REPLAY_PATH=fixtures/search/probe.json
MODELSTUDIO_TOKEN_LIMIT=900000
MODELSTUDIO_ASR_SECONDS_LIMIT=30000

# dshow on Windows, avfoundation on macOS, pulse on Linux.
# Optional full paths. Otherwise use a project-local tool or the system PATH.
FFMPEG_PATH=
FFPROBE_PATH=
AUDIO_INPUT_FORMAT=dshow
AUDIO_DEVICE=
ASR_LANGUAGE=en
# VOD offset correction measured in probe 1792830555944; see docs/twitch.md.
VOD_OFFSET_CORRECTION_S=-3.4

# Receipt Worker origin, for example https://receipts.<subdomain>.workers.dev. See docs/public-pages.md.
RESULTS_BASE_URL=
RESULTS_SIGNING_KEY=
CHAT_RETENTION_DAYS=14
