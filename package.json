{
  "name": "chat-is-this-real",
  "version": "0.1.0",
  "private": true,
  "description": "Sourced checks and stream memory for Twitch.",
  "type": "module",
  "license": "MIT",
  "overrides": {
    "miniflare": { "undici": "7.30.1" }
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:web": "vite build",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "eval": "tsx eval/run.ts",
    "eval:verify": "tsx eval/run.ts --verify-lock",
    "demo": "npm run build && node dist/server/index.js --demo",
    "setup:twitch": "tsx scripts/setup-twitch.ts",
    "setup:public": "tsx scripts/setup-public.ts",
    "worker:dev": "wrangler dev --config worker/wrangler.toml --local --ip 127.0.0.1 --port 8787 --persist-to .cache/worker-state",
    "worker:check": "wrangler deploy --config worker/wrangler.toml --dry-run --outdir .cache/worker-build",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "probe:twitch": "tsx scripts/probe-twitch.ts",
    "probe:core": "tsx scripts/probe-core.ts",
    "probe:engine": "tsx scripts/probe-engine.ts",
    "probe:vod": "tsx scripts/probe-vod.ts",
    "probe:overlay": "tsx scripts/probe-overlay.ts",
    "probe:asr-fallback": "tsx scripts/probe-asr-fallback.ts",
    "purge": "tsx scripts/purge.ts",
    "probe:models": "tsx scripts/probe-models.ts",
    "report:models": "tsx scripts/report-models.ts",
    "report:claims": "tsx scripts/report-claims.ts",
    "report:vod": "tsx scripts/report-vod.ts",
    "record:test": "tsx scripts/make-test-recording.ts",
    "broadcast:test": "tsx scripts/broadcast-test.ts",
    "companion": "tsx companion/index.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.7",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@mozilla/readability": "0.6.0",
    "fastify": "5.12.7",
    "linkedom": "0.18.14",
    "openai": "7.43.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  }
}
