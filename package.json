{
  "name": "chat-is-this-real",
  "version": "0.1.0",
  "private": true,
  "description": "Sourced checks and stream memory for Twitch.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "eval": "tsx eval/run.ts",
    "eval:verify": "tsx eval/run.ts --verify-lock",
    "demo": "tsx scripts/milestone-command.ts demo",
    "setup:twitch": "tsx scripts/setup-twitch.ts",
    "probe:twitch": "tsx scripts/probe-twitch.ts",
    "probe:core": "tsx scripts/probe-core.ts",
    "probe:engine": "tsx scripts/probe-engine.ts",
    "purge": "tsx scripts/purge.ts",
    "probe:models": "tsx scripts/probe-models.ts",
    "report:models": "tsx scripts/report-models.ts",
    "report:claims": "tsx scripts/report-claims.ts",
    "record:test": "tsx scripts/make-test-recording.ts",
    "broadcast:test": "tsx scripts/broadcast-test.ts",
    "companion": "tsx scripts/milestone-command.ts companion"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "fastify": "5.12.7",
    "linkedom": "0.18.14",
    "openai": "7.43.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
